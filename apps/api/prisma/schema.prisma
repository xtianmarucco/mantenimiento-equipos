// Prisma schema for the API. Models are added by the feature that needs them.
// The connection URL lives in `prisma.config.ts` (Prisma 7).
// Enums and fields mirror the zod schemas in `packages/shared`; keep them in sync. Enum parity
// is enforced by `src/shared/infrastructure/prisma-enums.test.ts`; length limits are not.
// Tables and columns use snake_case (`@@map` / `@map`); the client keeps camelCase.
// Name columns (`locations.name`, `equipment.name`) use the ICU collation `es_natural` (Spanish
// alphabetical order), created and applied in migration `20261101200000_spanish_name_collation`.
// Prisma cannot express column collations and ignores them when diffing, so `migrate dev` does
// not revert it; a new name column that must sort in Spanish needs the same `COLLATE` by hand.
// The collation version follows the image's ICU: see README "Collation version" before changing
// the postgres image tag.
// `equipment` has the CHECK constraint `equipment_warranty_after_purchase_check`
// (`warranty_until IS NULL OR warranty_until >= purchase_date`), added in migration
// `20261101210000_equipment_warranty_check`. Prisma cannot express CHECK constraints and ignores
// them when diffing; `PrismaEquipmentRepository` maps the violation by the constraint's name, so
// keep the name in sync if it ever changes.
// `equipment_events` has the CHECK constraint `equipment_events_cost_non_negative_check`
// (`cost IS NULL OR cost >= 0`), added by hand in migration `20261112010054_equipment_events`.
// Its foreign keys keep Prisma's default names (`equipment_events_<column>_fkey`);
// `PrismaEquipmentRepository` maps their violations by name, so keep them in sync.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum LocationKind {
  OWN_STORE
  THIRD_PARTY

  @@map("location_kind")
}

enum EquipmentType {
  FREEZER
  REFRIGERATOR
  DISPLAY_CASE
  ICE_CREAM_MACHINE
  OTHER

  @@map("equipment_type")
}

enum EquipmentStatus {
  OPERATIONAL
  IN_REPAIR
  OUT_OF_SERVICE
  RETIRED

  @@map("equipment_status")
}

enum EquipmentEventType {
  MAINTENANCE
  BREAKDOWN
  REPAIR
  TRANSFER
  REPLACEMENT
  RETIREMENT

  @@map("equipment_event_type")
}

/// An own store or a third-party kiosk where equipment lives.
model Location {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(120)
  kind        LocationKind
  address     String?      @db.VarChar(200)
  contactName String?      @map("contact_name") @db.VarChar(120)
  phone       String?      @db.VarChar(20)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  equipment  Equipment[]
  eventsFrom EquipmentEvent[] @relation("EventFromLocation")
  eventsTo   EquipmentEvent[] @relation("EventToLocation")

  @@map("locations")
}

/// A piece of equipment, identified by its unique internal code (the QR payload).
model Equipment {
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique @db.VarChar(20)
  name          String          @db.VarChar(120)
  type          EquipmentType
  brand         String          @db.VarChar(80)
  model         String          @db.VarChar(80)
  serialNumber  String?         @map("serial_number") @db.VarChar(80)
  purchaseDate  DateTime        @map("purchase_date") @db.Date
  warrantyUntil DateTime?       @map("warranty_until") @db.Date
  status        EquipmentStatus @default(OPERATIONAL)
  notes         String?         @db.VarChar(1000)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  locationId String   @map("location_id") @db.Uuid
  // Restrict: a location that still holds equipment cannot be deleted.
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  events            EquipmentEvent[] @relation("EventEquipment")
  replacementEvents EquipmentEvent[] @relation("EventReplacementEquipment")

  @@index([locationId])
  @@index([status])
  @@map("equipment")
}

/// Something that happened to an equipment item. Append-only: never edited or deleted. One flat row
/// per event; the type-specific columns are `null` when they do not apply to its type.
model EquipmentEvent {
  id              String             @id @default(uuid()) @db.Uuid
  type            EquipmentEventType
  occurredOn      DateTime           @map("occurred_on") @db.Date
  description     String             @db.VarChar(1000)
  technician      String?            @db.VarChar(120)
  // ARS, two decimals; the shared schema caps it at 99,999,999.99 to fit.
  cost            Decimal?           @db.Decimal(10, 2)
  resultingStatus EquipmentStatus?   @map("resulting_status")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  // Restrict everywhere: history keeps the records it mentions.
  equipmentId            String     @map("equipment_id") @db.Uuid
  equipment              Equipment  @relation("EventEquipment", fields: [equipmentId], references: [id], onDelete: Restrict)
  fromLocationId         String?    @map("from_location_id") @db.Uuid
  fromLocation           Location?  @relation("EventFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId           String?    @map("to_location_id") @db.Uuid
  toLocation             Location?  @relation("EventToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  replacementEquipmentId String?    @map("replacement_equipment_id") @db.Uuid
  replacementEquipment   Equipment? @relation("EventReplacementEquipment", fields: [replacementEquipmentId], references: [id], onDelete: Restrict)

  // History of one equipment item, newest first.
  @@index([equipmentId, occurredOn(sort: Desc), createdAt(sort: Desc)])
  @@map("equipment_events")
}
